FROM python:3.11-slim

WORKDIR /app

# Install dependencies first (layer caching).
COPY requirements.txt requirements-tracking.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# MLflow tracking client (optional; build with --build-arg WITH_TRACKING=false
# for a smaller image — tracking then becomes a no-op).
ARG WITH_TRACKING=true
RUN if [ "$WITH_TRACKING" = "true" ]; then \
      pip install --no-cache-dir -r requirements-tracking.txt; \
    fi

# Copy application code.
COPY app/ ./app/
COPY experiments/ ./experiments/

# Expose the API port.
EXPOSE 8000

# Run with uvicorn.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
