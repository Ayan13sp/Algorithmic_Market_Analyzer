# Copy to backend/.env for local overrides. All values are optional.

# Defaults to a local SQLite file; use PostgreSQL in Docker / Render.
# DATABASE_URL=postgresql://market_user:market_pass@localhost:5432/market_analyzer

# Extra allowed CORS origins, comma-separated (e.g. your deployed frontend URL).
# EXTRA_CORS_ORIGINS=https://your-frontend.onrender.com

# ── MLflow experiment tracking (requires requirements-tracking.txt) ──
# MLFLOW_ENABLED=true
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db     # or http://localhost:5000
# MLFLOW_EXPERIMENT_NAME=market-direction-classifier
# MLFLOW_REGISTER_MODELS=true

# ── Walk-forward validation (defaults keep /api/analyze responsive) ──
# WF_INITIAL_TRAIN_DAYS=504   # first training window (~2 trading years)
# WF_STEP_DAYS=63             # refit and predict one quarter at a time
# WF_RETUNE_EVERY=4           # re-run the hyperparameter search every N folds (0 = once, 1 = every fold)
# ML_N_JOBS=-1                # joblib workers for tuning; use 1 on a single-CPU instance
